# Existing PostgreSQL; this project does not create or manage it.
APP_ENV=production
# Pin both values to the same immutable release tag or digest before deployment.
# Example release tag; replace v0.1.0 with the reviewed version to deploy.
MOMO_BACKEND_IMAGE=ghcr.io/davisding/momobox-backend:v0.1.0
APP_VERSION=v0.1.0
MOMO_BACKEND_PORT=8080
# Existing database hostname/alias on DATABASE_NETWORK, not localhost.
# This example assumes a private local Docker network; outside it require TLS.
# Use a dedicated non-superuser role and MomoBox database, never the LiteLLM DB.
DATABASE_URL=postgres://momobox_user:change-me@shared-postgres:5432/momobox?sslmode=disable
DATABASE_NETWORK=replace-with-existing-docker-network
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes
# Generate with: openssl rand -hex 32
REFRESH_TOKEN_PEPPER=replace-with-long-random-secret
# Must be exactly 32 ASCII bytes. Generate with: openssl rand -hex 16
HA_TOKEN_ENCRYPTION_KEY=change-this-key-to-exactly-32byt
REGISTRATION_MODE=first_setup
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
MAX_REQUEST_BODY_BYTES=1048576
LOG_LEVEL=info

# Backup/restore/update require this official image to match the existing server's major.
# Verified from Docker Hub 2026-11-02; change to the documented PG18 digest for PG18.
PG_CLIENT_IMAGE=docker.io/library/postgres@sha256:5660c2cbfea50c7a9127d17dc4e48543eedd3d7a41a595a2dfa572471e37e64c

# Optional backend-managed compatible AI provider (keys never stored on phones)
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
AI_PROTOCOL=auto
AI_SECONDARY_ENDPOINT=
AI_SECONDARY_MODEL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_PROTOCOL=auto
AI_FALLBACK_ENDPOINT=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_PROTOCOL=auto
